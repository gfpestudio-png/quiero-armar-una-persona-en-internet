      "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>FERNANDEZPEGO & RUSSO | Estudio Jurídico</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <!-- Lucide Icons -->\n    <script src=\"https://unpkg.com/lucide@latest\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased\">\n\n    <!-- Header / Navbar -->\n    <header class=\"sticky top-0 z-50 bg-slate-900 text-white shadow-md border-b border-blue-900/40\">\n        <div class=\"max-w-6xl mx-auto px-4 py-4 flex justify-between items-center\">\n            <div class=\"flex items-center space-x-2\">\n                <i data-lucide=\"scale\" class=\"w-8 h-8 text-amber-500\"></i>\n                <span class=\"text-xl font-bold tracking-wider\">FERNANDEZPEGO <span class=\"text-amber-400\">&</span> RUSSO</span>\n            </div>\n            <nav class=\"hidden md:flex space-x-8 text-sm font-medium\">\n                <a href=\"#inicio\" class=\"hover:text-amber-400 transition-colors\">Inicio</a>\n                <a href=\"#areas\" class=\"hover:text-amber-400 transition-colors\">Áreas de Práctica</a>\n                <a href=\"#especialidades\" class=\"hover:text-amber-400 transition-colors\">Servicios</a>\n                <a href=\"#contacto\" class=\"hover:text-amber-400 transition-colors\">Contacto</a>\n            </nav>\n            <a href=\"https://wa.me/5491140565843?text=Hola,%20me%20comunico%20desde%20la%20web%20para%20realizar%20una%20consulta%20jur%C3%ADdica.\" target=\"_blank\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 transition-colors shadow-sm\">\n                <i data-lucide=\"message-circle\" class=\"w-4 h-4\"></i>\n                <span>WhatsApp Directo</span>\n            </a>\n        </div>\n    </header>\n\n    <!-- Hero Section -->\n    <section id=\"inicio\" class=\"relative bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-24 px-4 overflow-hidden\">\n        <div class=\"absolute inset-0 opacity-10 bg-[radial-gradient(#b45309_1px,transparent_1px)] [background-size:16px_16px]\"></div>\n        <div class=\"max-w-4xl mx-auto text-center relative z-10\">\n            <div class=\"inline-flex items-center space-x-2 bg-amber-500/10 border border-amber-500/30 text-amber-400 px-4 py-1.5 rounded-full text-sm font-medium mb-6\">\n                <i data-lucide=\"shield-check\" class=\"w-4 h-4\"></i>\n                <span>Asesoramiento Legal Integral y Estratégico</span>\n            </div>\n            <h1 class=\"text-4xl md:text-6xl font-bold tracking-tight mb-6 leading-tight\">\n                FERNANDEZPEGO <span class=\"text-amber-400\">&</span> RUSSO\n            </h1>\n            <p class=\"text-lg md:text-xl text-slate-300 mb-10 max-w-2xl mx-auto leading-relaxed\">\n                Defendemos sus derechos con rigor profesional, experiencia y atención personalizada en cada etapa de su caso.\n            </p>\n            <div class=\"flex flex-col sm:flex-row justify-center gap-4\">\n                <a href=\"https://wa.me/5491140565843?text=Hola,%20quisiera%20agendar%20una%20consulta%20legal.\" target=\"_blank\" class=\"bg-amber-600 hover:bg-amber-700 text-white font-semibold px-8 py-3.5 rounded-xl transition-all shadow-lg flex items-center justify-center space-x-2\">\n                    <i data-lucide=\"phone-call\" class=\"w-5 h-5\"></i>\n                    <span>Agendar Consulta Legal (1140565843)</span>\n                </a>\n                <a href=\"#areas\" class=\"bg-slate-800 hover:bg-slate-700 text-white font-semibold px-8 py-3.5 rounded-xl border border-slate-700 transition-all flex items-center justify-center space-x-2\">\n                    <span>Conocer Especialidades</span>\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- 5 Áreas de Práctica Principales -->\n    <section id=\"areas\" class=\"py-20 px-4 bg-white\">\n        <div class=\"max-w-6xl mx-auto\">\n            <div class=\"text-center max-w-2xl mx-auto mb-16\">\n                <h2 class=\"text-3xl md:text-4xl font-bold text-slate-900 mb-4\">Áreas de Práctica Principales</h2>\n                <p class=\"text-slate-600\">Nuestra experiencia jurídica enfocada en resolver sus necesidades con eficacia.</p>\n            </div>\n            \n            <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <!-- Área 1 -->\n                <div class=\"bg-slate-50 border border-slate-200 p-8 rounded-2xl hover:shadow-xl transition-all hover:border-blue-900/30 group\">\n                    <div class=\"w-12 h-12 bg-blue-900/10 rounded-xl flex items-center justify-center text-blue-900 mb-6 group-hover:bg-blue-900 group-hover:text-white transition-colors\">\n                        <i data-lucide=\"users\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-3\">Conflictos Familiares</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">Asistencia integral en divorcios, régimen de comunicación, alimentos, cuidado personal y uniones convivenciales.</p>\n                </div>\n                <!-- Área 2 -->\n                <div class=\"bg-slate-50 border border-slate-200 p-8 rounded-2xl hover:shadow-xl transition-all hover:border-blue-900/30 group\">\n                    <div class=\"w-12 h-12 bg-blue-900/10 rounded-xl flex items-center justify-center text-blue-900 mb-6 group-hover:bg-blue-900 group-hover:text-white transition-colors\">\n                        <i data-lucide=\"gavel\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-3\">Soluciones Penales</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">Defensa penal rigurosa, patrocinio en querellas, excarcelaciones y asesoramiento preventivo ante instancias judiciales.</p>\n                </div>\n                <!-- Área 3 -->\n                <div class=\"bg-slate-50 border border-slate-200 p-8 rounded-2xl hover:shadow-xl transition-all hover:border-blue-900/30 group\">\n                    <div class=\"w-12 h-12 bg-blue-900/10 rounded-xl flex items-center justify-center text-blue-900 mb-6 group-hover:bg-blue-900 group-hover:text-white transition-colors\">\n                        <i data-lucide=\"file-text\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-3\">Problemas Sucesorios</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">Gestión de declaratorias de herederos, partición de bienes, sucesiones testamentarias y administración de patrimonios.</p>\n                </div>\n                <!-- Área 4 -->\n                <div class=\"bg-slate-50 border border-slate-200 p-8 rounded-2xl hover:shadow-xl transition-all hover:border-blue-900/30 group\">\n                    <div class=\"w-12 h-12 bg-blue-900/10 rounded-xl flex items-center justify-center text-blue-900 mb-6 group-hover:bg-blue-900 group-hover:text-white transition-colors\">\n                        <i data-lucide=\"briefcase\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-3\">Inconvenientes Laborales</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">Reclamos por despidos, diferencias salariales, registración defectuosa, accidentes de trabajo y litigios laborales.</p>\n                </div>\n                <!-- Área 5 -->\n                <div class=\"bg-slate-50 border border-slate-200 p-8 rounded-2xl hover:shadow-xl transition-all hover:border-blue-900/30 group md:col-span-2 lg:col-span-1\">\n                    <div class=\"w-12 h-12 bg-blue-900/10 rounded-xl flex items-center justify-center text-blue-900 mb-6 group-hover:bg-blue-900 group-hover:text-white transition-colors\">\n                        <i data-lucide=\"heart-pulse\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold text-slate-900 mb-3\">Amparo de Salud</h3>\n                    <p class=\"text-slate-600 text-sm leading-relaxed\">Acciones urgentes contra obras sociales y prepagas por cobertura de medicamentos, tratamientos y discapacidad.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- También Resolvemos (Especialidades Adicionales) -->\n    <section id=\"especialidades\" class=\"py-20 px-4 bg-slate-100 border-t border-slate-200\">\n        <div class=\"max-w-6xl mx-auto\">\n            <div class=\"text-center max-w-2xl mx-auto mb-12\">\n                <h2 class=\"text-3xl font-bold text-slate-900 mb-3\">También Resolvemos</h2>\n                <p class=\"text-slate-600\">Servicios jurídicos y administrativos especializados adicionales:</p>\n            </div>\n            \n            <div class=\"flex flex-wrap justify-center gap-3 max-w-4xl mx-auto\">\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Jubilaciones</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Pensiones</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Mensura</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">División de Bienes</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Divorcios</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">CNRT</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Ciudadanía</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Electoral</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">ART</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Consorcios</span>\n                <span class=\"bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium shadow-sm\">Expensas en Country</span>\n            </div>\n        </div>\n    </section>\n\n    <!-- Sección de Contacto Directo -->\n    <section id=\"contacto\" class=\"py-20 px-4 bg-white border-t border-slate-200\">\n        <div class=\"max-w-4xl mx-auto text-center\">\n            <h2 class=\"text-3xl font-bold text-slate-900 mb-4\">¿Necesita Asesoramiento Inmediato?</h2>\n            <p class=\"text-slate-600 mb-8 max-w-xl mx-auto\">Contáctenos de forma directa a través de nuestro canal de WhatsApp para evaluar su caso a la brevedad.</p>\n            <a href=\"https://wa.me/5491140565843?text=Hola,%20necesito%20hacer%20una%20consulta%20con%20el%20estudio.\" target=\"_blank\" class=\"inline-flex items-center space-x-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-8 py-4 rounded-xl text-lg shadow-lg transition-transform hover:scale-105\">\n                <i data-lucide=\"message-circle\" class=\"w-6 h-6\"></i>\n                <span>Env